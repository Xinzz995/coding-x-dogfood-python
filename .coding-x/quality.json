          "command": {
            "executable": ".venv/Scripts/python.exe",
            "args": [
              "-m",
              "ruff",
              "check",
              "--no-cache",
              "packages/worker"
            ],
            "cwd": ".",
            "platforms": [
              "windows"
            ],
            "timeoutMs": 600000
          }
        }
      ]
    },
    "security": {
      "notApplicable": "此公开试点仓库不处理生产数据且没有独立安全扫描器；本次只验证多包原生门禁，后续不得把该不适用结论复用于生产项目。"
    }
  },
  "risk": {
    "defaultCategories": [
      "policy",
