        "cwd": ".",
        "platforms": [
          "windows"
        ],
        "timeoutMs": 600000
      },
      {
        "executable": ".venv/Scripts/python.exe",
        "args": [
          "-m",
          "pip",
          "install",
          "pip==25.3",
          "packages/api[dev]",
          "packages/worker[dev]"
        ],
        "cwd": ".",
        "platforms": [
          "windows"
        ],
        "timeoutMs": 600000
      }
    ],
    "allowedPaths": [
      ".venv/**"
    ]
  },
  "checks": {
