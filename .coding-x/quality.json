      "checks": [
        {
          "id": "test-packages-api-posix",
          "module": "packages-api",
          "command": {
            "executable": ".venv/bin/python",
            "args": [
              "-B",
              "-m",
              "pytest",
              "-p",
              "no:cacheprovider",
              "packages/api/tests"
            ],
            "cwd": ".",
            "platforms": [
              "linux",
              "macos"
            ],
            "timeoutMs": 600000
          }
        },
        {
          "id": "test-packages-worker-posix",
          "module": "packages-worker",
