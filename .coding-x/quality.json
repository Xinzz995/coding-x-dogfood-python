{
  "schemaVersion": 2,
  "codingXVersion": "0.34.1",
  "repository": {
    "provider": "github",
    "fullName": "Xinzz995/coding-x-dogfood-python",
    "defaultBranch": "main"
  },
  "release": {
    "protectedRefs": [
      "v*"
    ]
  },
  "sources": {
    "specs": [
      {
        "kind": "pull-request"
      }
    ],
    "acceptanceCriteria": [
      {
        "kind": "pull-request"
      }
    ],
    "engineeringStandards": [
      "AGENTS.md",
      "README.md"
    ]
  },
  "modules": [
    {
      "id": "packages-api",
      "path": "packages/api"
    },
    {
      "id": "packages-worker",
      "path": "packages/worker"
    }
  ],
  "generatedPaths": [
    "packages/api/build/**",
    "packages/api/dist/**",
    "packages/api/src/coding_x_dogfood_api.egg-info/**",
    "packages/worker/build/**",
    "packages/worker/dist/**",
    "packages/worker/src/coding_x_dogfood_worker.egg-info/**"
  ],
  "localValidation": {
    "prepare": [
      {
        "executable": "python3.12",
        "args": [
          "-m",
          "venv",
          ".venv"
        ],
        "cwd": ".",
        "platforms": [
          "linux"
        ],
        "timeoutMs": 600000
      },
      {
        "executable": ".venv/bin/python",
        "args": [
          "-m",
          "pip",
          "install",
          "pip==25.3",
          "packages/api[dev]",
          "packages/worker[dev]"
        ],
        "cwd": ".",
        "platforms": [
          "linux"
        ],
        "timeoutMs": 600000
      },
      {
        "executable": "python3.12",
        "args": [
          "-m",
          "venv",
          ".venv"
        ],
        "cwd": ".",
        "platforms": [
          "macos"
        ],
        "timeoutMs": 600000
      },
      {
        "executable": ".venv/bin/python",
        "args": [
          "-m",
          "pip",
          "install",
          "pip==25.3",
          "packages/api[dev]",
          "packages/worker[dev]"
        ],
        "cwd": ".",
        "platforms": [
          "macos"
        ],
        "timeoutMs": 600000
      },
      {
        "executable": "python",
        "args": [
